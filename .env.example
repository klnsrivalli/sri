# Database Configuration
# Use SQLite for local development or PostgreSQL for production
DATABASE_URL=sqlite:///competitor_monitoring.db
# DATABASE_URL=postgresql://user:password@localhost:5432/competitor_monitoring

# Email Notifications
# Set to true to enable email alerts
EMAIL_ENABLED=false

# Gmail configuration (recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENTS=recipient1@email.com,recipient2@email.com

# SMTP server configuration (alternative to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Monitoring Settings
# How often to check prices (in seconds)
CHECK_INTERVAL=3600

# Minimum price change to trigger alert (as decimal, e.g., 0.05 = 5%)
PRICE_CHANGE_THRESHOLD=0.05

# Maximum retry attempts for failed scraping
MAX_RETRIES=3

# Request timeout in seconds
TIMEOUT=30

# Scraping Configuration
# Delay between requests to the same domain (in seconds)
REQUEST_DELAY=5

# User agent rotation
USE_RANDOM_USER_AGENT=true

# Logging
# Set to DEBUG for verbose logging, INFO for normal operation
LOG_LEVEL=INFO